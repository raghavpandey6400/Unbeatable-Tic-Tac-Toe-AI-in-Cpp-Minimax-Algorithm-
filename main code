int check (char *space,char player1,char player2){
for (int i =0 ;i<9 ;i=i+3 )
{  
    if(space[i]!=' '&&space[i]==space[i+1]&&space[i+1]==space[i+2]){return (space[i] == player2) ? 10 : -10;}
}

for (int i = 0; i < 3; i++) {
        if (space[i] != ' ' && space[i] == space[i + 3] && space[i + 3] == space[i + 6])
            return (space[i] == player2) ? 10 : -10;
    }

    if (space[0] != ' ' && space[0] == space[4] && space[4] == space[8])
        return (space[0] == player2) ? 10 : -10;
    if (space[2] != ' ' && space[2] == space[4] && space[4] == space[6])
        return (space[2] == player2) ? 10 : -10;

return 0 ;

}

int minmax (char *space,char player1,char player2,int depth, bool ismax){

    int num = check(space,player1,player2);

    if(num==10){return num - depth;}
    if(num== -10){return num + depth;}

    bool empty_or_not = 0;

    for(int i = 0;i<9;i++){

        if(space[i]==' '){empty_or_not = 1; }
    }
    if(!empty_or_not){return 0;}

      if (ismax){
        int best = -1000;
                   for(int i=0;i<9;i++){
                   if(space[i] == ' '){
                    space[i]=player2;
                    best = std::max(best ,minmax (space,player1, player2,depth+1 , !ismax));
                    space[i]=' ';
                    
                   }}
                   return best;
      }
      else {
        int best = 1000;
                   for(int i=0;i<9;i++){
                if(space[i] == ' '){
                    space[i]=player1;
                    best = std::min(best ,minmax (space,player1, player2,depth+1 , !ismax));
                    space[i]=' ';
                    
                   }
                   }return best;
      }
}
